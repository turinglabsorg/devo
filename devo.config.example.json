        "letzgo-agent-worker",
        "letzgo-app",
        "letzgo-be",
        "letzgo-gate",
        "letzgo-landing",
        "letzgo-partners"
      ],
      "labels": {
        "client": "LETZGO"
      },
      "notes": "LETZGO on Google Cloud, linked to @zonzolab LetzGo repositories"
